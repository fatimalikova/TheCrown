506
00:29:05,200 --> 00:29:07,360
<font color="#00ff00">Right...</font><font color="#00ffff"> Wait a minute!</font>

507
00:29:07,360 --> 00:29:09,200
<font color="#00ffff">Let me go first.</font>

508
00:29:11,000 --> 00:29:13,240
<font color="#ffffff">STATIC CRACKLES</font>

509
00:29:17,680 --> 00:29:18,880
<font color="#00ffff">Hmm.</font>

510
00:29:18,880 --> 00:29:21,680
<font color="#00ffff">Awaiting further instructions,</font>
<font color="#00ffff">I would think.</font>

511
00:29:24,800 --> 00:29:26,840
<font color="#ffffff">LOUD BURST OF STATIC</font>

